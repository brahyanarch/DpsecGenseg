// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Looking for ways to speed up your queries, or scale easily with your serverless or edge functions?
// Try Prisma Accelerate: https://pris.ly/cli/accelerate-init

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("POSTGRESDB_URL")
}

// USUARIO ADMINIDTRADOR
model User {
  id                Int       @id @default(autoincrement())
  usuario           String    @unique
  password          String
  failedAttempts    Int       @default(0) // Número de intentos fallidos
  lastFailedAttempt DateTime? // Hora del último intento fallido

  softDeleted Boolean   @default(false) // Campo para soft delete
  deletedAt   DateTime? // Campo para soft delete

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

// TABLA DE ROLES
model Rol {
  id_rol Int    @id @default(autoincrement())
  n_rol  String @unique
  abrev  String

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  softDeleted Boolean   @default(false) // Campo para soft delete
  deletedAt   DateTime? // Campo para soft delete

  datellePermisos DetallePermiso[]
  usuarios        Usuario[]
}

// TABLA DE PERMISOS
model Permiso {
  id_per      Int     @id @default(autoincrement())
  n_per       String  @unique
  abreviatura String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  softDeleted Boolean   @default(false) // Campo para soft delete
  deletedAt   DateTime? // Campo para soft delete

  datellePermisos DetallePermiso[]
}

// TABLA AUXILIAR
model DetallePermiso {
  id_dper  Int     @id @default(autoincrement())
  id_rol   Int
  id_per   Int
  estado   Boolean @default(false)
  permisos Permiso @relation(fields: [id_per], references: [id_per])
  roles    Rol     @relation(fields: [id_rol], references: [id_rol])
}

// TABLA DE SUB UNIDAD
model Sub_unidad {
  id_subuni   Int    @id @default(autoincrement())
  n_subuni    String @unique
  abreviatura String

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  softDeleted Boolean   @default(false) // Campo para soft delete
  deletedAt   DateTime? // Campo para soft delete

  usuarios    Usuario[]
  templateDoc TemplateDoc[]
  //CerTemplates   CerTemplate[]
}

// TABLA DE DATOS DEL USUARIO
model DatosUsuario {
  iddatauser        Int       @id @default(autoincrement())
  dni               String    @unique @db.Char(8)
  email             String    @unique
  nombre            String
  APaterno          String
  AMaterno          String
  password          String
  idpe              Int?
  lastFailedAttempt DateTime? // Hora del último intento fallido
  failedAttempts    Int       @default(0) // Número de intentos fallidos

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  softDeleted Boolean   @default(false)
  deletedAt   DateTime? // Campo para soft delete

  usuario Usuario[]
  prgest  PrgEstudio? @relation(fields: [idpe], references: [idpe])
}

// USUARIO CON UN ROL EN UNA SUB UNIDAD
model Usuario {
  iduser Int     @id @default(autoincrement())
  estado Boolean @default(true)

  idrol       Int
  idsubunidad Int
  iddatauser  Int

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  softDeleted Boolean   @default(false) // Campo para soft delete
  deletedAt   DateTime? // Campo para soft delete

  roles       Rol          @relation(fields: [idrol], references: [id_rol])
  subunidad   Sub_unidad   @relation(fields: [idsubunidad], references: [id_subuni])
  datausuario DatosUsuario @relation(fields: [iddatauser], references: [iddatauser])

  document Document[]

  @@unique([iddatauser, idrol, idsubunidad])
}

// CerTemplateS DINAMICAS DE DOCUMENTOS PARA UNA ACTIVIDAD
model TemplateDoc {
  idtdoc   Int     @id @default(autoincrement())
  name     String
  estado   Boolean @default(false)
  abre     String?
  latex    String? // Contenido en formato LaTeX
  caratula String? // caratula en latex

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  softDeleted Boolean   @default(false) // Campo para soft delete
  deletedAt   DateTime? // Campo para soft delete

  idsubuni  Int
  subunidad Sub_unidad @relation(fields: [idsubuni], references: [id_subuni])
  block    Block[]
  campo    Campos[]
  document Document[]

  @@unique([name, idsubuni])
}

enum BlockType {
  SECTION
  SUBSECTION
  SUBSUBSECTION
  PARAGRAPH
  ITEMIZE
  ENUMERATE
  IMAGE
}

// TABLA DE BLOQUES DE PREGUNTAS
model Block {
  idblock     Int       @id @default(autoincrement())
  content     String?
  placeholder String?
  caption     String?
  type        BlockType
  orden       Int       @default(0)

  idtdoc Int

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  softDeleted Boolean   @default(false) // Campo para soft delete
  deletedAt   DateTime? // Campo para soft delete

  values      Value[]
  templateDoc TemplateDoc @relation(fields: [idtdoc], references: [idtdoc])
}

// TIPOS DE DATOS ACEPTADOS PARA CREAR UNA PREGUNTA QUE PERTENECE A UN FORM
enum Type {
  TEXT
  MULTIPLECHOICE
  SINGLECHOICE
  DROPDOWN
  DATE
  FILE
  NUMBER
}

// TABLA DE PREGUNTAS
model Campos {
  idca      Int      @id @default(autoincrement())
  nmCampo   String
  idtdoc    Int
  type      Type
  required  Boolean  @default(false)
  orden     Int      @default(0)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  templateDoc TemplateDoc @relation(fields: [idtdoc], references: [idtdoc])
  opcs        Opc[]
  resom       ResOM[]
  resou       ResOU[]
  resod       ResOD[]
  restxt      ResTxt[]
  resfile     ResFile[]
  resdate     ResDate[]
  resnum      ResNum[]
}

// RESPUESTAS
model Document {
  iddoc  Int      @id @default(autoincrement())
  date   DateTime @default(now())
  pdf    String?
  values Value[]

  idtdoc Int

  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  softDeleted Boolean   @default(false) // Campo para soft delete
  deletedAt   DateTime? // Campo para soft delete
  idusuario   Int

  templateDoc TemplateDoc @relation(fields: [idtdoc], references: [idtdoc])
  usuario     Usuario     @relation(fields: [idusuario], references: [iduser])

  //resom     ResOM[]
  //resou     ResOU[]
  //resod     ResOD[]
  //restxt    ResTxt[]
  //resfile   ResFile[]
  //resdate   ResDate[]
  //resnum    ResNum[]
  actividad Actividad[]
  //alumnoPD AlumnoTemplate[]
}

model Value {
  idval     Int      @id @default(autoincrement())
  iddoc     Int
  idblock   Int
  textValue String?
  listValue String[]
  imagePath String?
  caption   String?

  document Document @relation(fields: [iddoc], references: [iddoc])
  block    Block    @relation(fields: [idblock], references: [])
}

// TABLA DE OPCIONES
model Opc {
  idOpc  Int    @id @default(autoincrement())
  idCam  Int
  txtOpc String

  campos Campos  @relation(fields: [idCam], references: [idca])
  resom  ResOM[]
  resou  ResOU[]
  resod  ResOD[]
}

// TABLA DE RESPUESTAS DE TIPO OPCION MULTIPLE
model ResOM {
  idresom Int    @id @default(autoincrement())
  idresPD Int
  idcam   Int
  idomul  Int
  //resTemplate ResTemplate @relation(fields: [idresPD], references: [idresPD])
  campos  Campos @relation(fields: [idcam], references: [idca])
  opcs    Opc    @relation(fields: [idomul], references: [idOpc])
}

// TABLA DE RESPUESTAS DE TIPO OPCION UNICA
model ResOU {
  idresou Int    @id @default(autoincrement())
  idresPD Int
  idcam   Int
  idop    Int
  //resTemplate ResTemplate @relation(fields: [idresPD], references: [idresPD])
  campos  Campos @relation(fields: [idcam], references: [idca])
  opcuni  Opc    @relation(fields: [idop], references: [idOpc])
}

// TABLA DE RESPUESTAS DE TIPO OPCION DESPLEGABLE
model ResOD {
  idresod Int    @id @default(autoincrement())
  idresPD Int
  idcam   Int
  idodes  Int
  //resTemplate ResTemplate @relation(fields: [idresPD], references: [idresPD])
  campos  Campos @relation(fields: [idcam], references: [idca])
  opcdes  Opc    @relation(fields: [idodes], references: [idOpc])
}

// TABLA DE RESPUESTAS DE TIPO TEXTO
model ResTxt {
  idrestxt Int     @id @default(autoincrement())
  idcam    Int
  idresPD  Int
  resTxt   String?
  //resTemplate ResTemplate @relation(fields: [idresPD], references: [idresPD])
  campos   Campos  @relation(fields: [idcam], references: [idca])
}

// TABLA DE RESPUESTAS DE TIPO ARCHIVO
model ResFile {
  idresfile Int     @id @default(autoincrement())
  idresPD   Int
  idcam     Int
  resFile   String?
  //resTemplate ResTemplate @relation(fields: [idresPD], references: [idresPD])
  campos    Campos  @relation(fields: [idcam], references: [idca])
}

// TABLA DE RESPUESTAS DE TIPO FECHA
model ResDate {
  idresdate Int      @id @default(autoincrement())
  idresPD   Int
  idcam     Int
  resdate   DateTime
  //resTemplate ResTemplate @relation(fields: [idresPD], references: [idresPD])
  campos    Campos   @relation(fields: [idcam], references: [idca])
}

// TABLA DE RESPUESTAS DE TIPO NUMERICO
model ResNum {
  idresnum Int      @id @default(autoincrement())
  idresPD  Int
  idcam    Int
  resnum   DateTime
  //resTemplate ResTemplate @relation(fields: [idresPD], references: [idresPD])
  campos   Campos   @relation(fields: [idcam], references: [idca])
}

// TABLA DE FACULTAD
model Facu {
  idfacu Int     @id @default(autoincrement())
  nmFacu String
  abrev  String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  escuelas Escuela[]
}

// TABLA DE UNA ESCUELA PROFESIONAL 
model Escuela {
  idesc  Int     @id @default(autoincrement())
  nmEsc  String
  idfacu Int
  abrev  String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  facu   Facu         @relation(fields: [idfacu], references: [idfacu])
  prgest PrgEstudio[]
}

// TABLA DE PROGRAMA DE ESTUDIO
model PrgEstudio {
  idpe  Int     @id @default(autoincrement())
  nmPE  String
  abrev String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  idesc   Int
  escuela Escuela @relation(fields: [idesc], references: [idesc])

  estudiante   Estudiante[]
  DatosUsuario DatosUsuario[]
}

// TABLA ESTUDIANTE
model Estudiante {
  idest           Int       @id @default(autoincrement())
  dni             String
  codigo          String    @unique @db.Char(6)
  nombre          String
  aPaterno        String
  aMaterno        String
  email           String
  fechaNacimiento DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  idpe   Int
  prgest PrgEstudio @relation(fields: [idpe], references: [idpe])
  //actividades AlumnoTemplate[]
  //receptor    Receptor[]
}

enum EstadoProyecto {
  PENDIENTE
  ARCHIVADO
  CURSO
  COMPLETADO
}

enum TipoProyecto {
  SUBUNIDAD
  PROGRAMAESTUDIO
}

enum STATUS {
  DRAFT
  ACTIVATE
}

// TABLA PROYECTO

// TIPO DE ESTADOS DE ACTIVIDAD
enum EstadoActividad {
  PENDIENTE
  EN_CURSO
  FINALIZADO
  CANCELADO
}

// TIPO DE ACTIVIDAD
enum TipoActividad {
  CURSO
  TALLER
  SEMINARIO
  CONFERENCIA
  OTRO
}

// TABLA ACTIVIDAD
model Actividad {
  idActividad  Int             @id @default(autoincrement())
  nombre       String
  fInit        DateTime
  fFin         DateTime
  estado       EstadoActividad @default(PENDIENTE)
  idString     String?
  responsables String?
  descripcion  String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  iddoc Int

  softDeleted Boolean   @default(false) // Campo para soft delete
  deletedAt   DateTime? // Campo para soft delete

  documents Document @relation(fields: [iddoc], references: [iddoc])
}

enum EstadoAlumnoActividad {
  INSCRITO
  COMPLETADO
  ABANDONADO
}
