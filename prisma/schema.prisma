// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Looking for ways to speed up your queries, or scale easily with your serverless or edge functions?
// Try Prisma Accelerate: https://pris.ly/cli/accelerate-init

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

// USUARIO ADMINIDTRADOR
model User {
  id Int            @id @default(autoincrement())
  usuario           String @unique
  password          String
  failedAttempts    Int @default(0) // Número de intentos fallidos
  lastFailedAttempt DateTime? // Hora del último intento fallido
}

// TABLA DE ROLES
model Rol {
  id_rol      Int     @id     @default(autoincrement())
  n_rol       String  @unique
  abrev       String

  createdAt             DateTime       @default(now())
  updatedAt             DateTime       @updatedAt
  
  datellePermisos   DetallePermiso[]
  usuarios          Usuario[]
}

model Permiso {
  id_per            Int     @id     @default(autoincrement())
  n_per             String  @unique
  abreviatura       String?

  createdAt             DateTime       @default(now())
  updatedAt             DateTime       @updatedAt

  datellePermisos    DetallePermiso[]
}

model DetallePermiso {
  id_dper           Int     @id     @default(autoincrement())
  id_rol            Int 
  id_per            Int
  estado            Boolean @default(false)
  permisos  Permiso @relation(fields: [id_per], references: [id_per])
  roles     Rol @relation(fields: [id_rol], references: [id_rol])
}

model Sub_unidad {
  id_subuni Int @id @default(autoincrement())
  n_subuni  String  @unique
  abreviatura     String

  createdAt             DateTime       @default(now())
  updatedAt             DateTime       @updatedAt

  usuarios     Usuario[]
  form         Form[]
  plantillas   Plantilla[]
  plantillasDoc PlantillaDocumento[]
}

model DatosUsuario {
  iddatauser            Int     @id @default(autoincrement())
  dni                   String  @db.Char(8) @unique
  email                 String  @unique
  nombre                String
  APaterno              String
  AMaterno              String
  password              String
  idpe                  Int?
  lastFailedAttempt     DateTime? // Hora del último intento fallido
  failedAttempts        Int @default(0) // Número de intentos fallidos
  deletedAt             DateTime? // Campo para soft delete

  createdAt             DateTime @default(now())
  updatedAt             DateTime  @updatedAt

  usuario               Usuario[]
  prgest                PrgEstudio?  @relation(fields: [idpe], references: [idpe])
}

model Usuario {
  iduser                Int     @id @default(autoincrement())
  estado                Boolean @default(true)

  idrol                 Int     
  idsubunidad           Int
  iddatauser            Int

  createdAt             DateTime @default(now())
  updatedAt             DateTime  @updatedAt
  
  roles                 Rol           @relation(fields: [idrol], references: [id_rol])
  subunidad             Sub_unidad    @relation(fields: [idsubunidad], references: [id_subuni])
  datausuario           DatosUsuario  @relation(fields: [iddatauser], references: [iddatauser])

  project               Project[]
  @@unique([iddatauser, idrol, idsubunidad])
}

model ConfigForm {
  idcf          Int @id @default(autoincrement())
  longActivity  Boolean @default(false)
  iddoc         Int?   @unique   
  idf           Int    @unique
  allowDocLink  Boolean @default(false)

  createdAt     DateTime @default(now())
  updatedAt     DateTime?

  form          Form @relation(fields: [idf], references: [idf])
  plantillaDoc  PlantillaDocumento? @relation(fields: [iddoc], references: [idplantilladoc])
}

model Form {
  idf         Int @id @default(autoincrement())
  nmForm      String  
  estado      Boolean @default(false)
  abre        String?

  createdAt   DateTime  @default(now())
  updatedAt   DateTime? 
  softDelete  Boolean   @default(false)
  
  config      ConfigForm?   
  idsubuni    Int
  subunidad   Sub_unidad @relation(fields: [idsubuni], references: [id_subuni])
  prg         Prg[]
  res         Res[]
}
enum Type {
  TEXT
  MULTIPLECHOICE
  SINGLECHOICE
  DROPDOWN
  DATE
  FILE
  NUMBER
}

model Prg {
  idp       Int @id @default(autoincrement())
  nmPrg     String  
  idf       Int
  type      Type
  required  Boolean @default(false)
  
  createdAt             DateTime       @default(now())
  updatedAt             DateTime       @updatedAt

  form      Form  @relation(fields: [idf], references: [idf])
  opcs      Opc[]
  answers   Answer[]
}

model Res {
  idres     Int @id @default(autoincrement())
  date      DateTime  @default(now())

  idf       Int

  createdAt             DateTime       @default(now())
  
  form      Form  @relation(fields: [idf], references: [idf])
  //actividad Actividad[] 
  answers   Answer[]  

}

model Opc {
  idOpc    Int @id @default(autoincrement())
  idp       Int
  txtOpc    String

  prg       Prg   @relation(fields: [idp], references: [idp])
}




enum EstadoPlataforma {
  PENDIENTE
  ARCHIVADO
  CURSO
  COMPLETADO
}
enum TipoProyecto {
  SUBUNIDAD
  PROGRAMAESTUDIO
}

model Project {
  idproj                Int     @id   @default(autoincrement())
  plan                  String?  
  estado                EstadoPlataforma
  tipo                  TipoProyecto
  idString              String?
  fInit                 DateTime?
  fFin                  DateTime?
  informeFinal          String?

  createdAt             DateTime       @default(now())
  updatedAt             DateTime       @updatedAt

  iduser                Int

  usuario               Usuario @relation(fields: [iduser], references: [iduser])  
  actividad             Actividad[]
}

model Actividad {
  idActivi              Int     @id   @default(autoincrement())
  name                  String  @unique
  fInit                 DateTime
  fFin                  DateTime
  estado                EstadoPlataforma @default(PENDIENTE)
  idString              String?
  public                Boolean   @default(false)
  tipo                  String    @default("normal")

  createdAt             DateTime       @default(now())
  updatedAt             DateTime       @updatedAt

  idproj                Int
  //idres                 Int
  project               Project   @relation(fields: [idproj], references: [idproj])
  //res                   Res       @relation(fields: [idres], references: [idres])
  alumnoActividad       AlumnoActividad[]
  Answer                Answer[]
}

model Answer {
  id          Int      @id @default(autoincrement())
  activityId  Int
  activity    Actividad @relation(fields: [activityId], references: [idActivi])
  questionId  Int
  prg         Prg?     @relation(fields: [questionId], references: [idp]) // Relación añadida
  textValue   String?
  optionId    Int?
  filePath    String?  // Campo añadido para rutas de archivos
  dateValue   DateTime? // Campo añadido para fechas
  numberValue Float?   // Campo añadido para números
  createdAt   DateTime @default(now()) // Valor por defecto añadido
  res         Res?     @relation(fields: [idres], references: [idres])
  idres       Int?
}

enum TipoSeccion {
  section
  subsection
  subsubsection
  text
  itemize
  enumerate
}

model PlantillaDocumento {
  idplantilladoc  Int @id @default(autoincrement())
  idsubunidad      Int
  
  nombre          String
  estado          Boolean   @default(true)
  descripcion     String?

  sofdelete       Boolean   @default(false)
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt
  
  cuerpo          CuerpoPlantillaDocumento[]
  subunidad       Sub_unidad @relation(fields: [idsubunidad], references: [id_subuni])
  configForms    ConfigForm?
}

model CuerpoPlantillaDocumento {
  idcuerpo        Int @id @default(autoincrement())
  idplantilladoc  Int

  type           TipoSeccion
  contenido      String?   // texto libre o título
  items          Json?     // lista de items si aplica
  iseditable     Boolean   @default(false)
  orden          Int?
  
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  plantillaDoc    PlantillaDocumento @relation(fields: [idplantilladoc], references: [idplantilladoc])
}

model Facu {
  idfacu    Int @id @default(autoincrement())
  nmFacu    String
  abrev     String?
  
  createdAt             DateTime       @default(now())
  updatedAt             DateTime       @updatedAt

  escuelas  Escuela[]
}

model Escuela {
  idesc     Int @id @default(autoincrement())
  nmEsc     String
  idfacu    Int
  abrev     String?

  createdAt             DateTime       @default(now())
  updatedAt             DateTime       @updatedAt
  
  facu      Facu @relation(fields: [idfacu], references: [idfacu])
  prgest    PrgEstudio[]
}

model PrgEstudio {
  idpe      Int @id @default(autoincrement())
  nmPE      String
  abrev     String?

  createdAt             DateTime       @default(now())
  updatedAt             DateTime       @updatedAt

  idesc     Int
  escuela   Escuela @relation(fields: [idesc], references: [idesc])

  estudiante Estudiante[]
  DatosUsuario DatosUsuario[]
}

model Estudiante {
  idest     Int     @id @default(autoincrement())
  dni       String  
  codigo    String  @unique @db.Char(6)
  nombre    String
  aPaterno  String
  aMaterno  String
  email     String
  fechaNacimiento DateTime?
  
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  idpe      Int
  prgest    PrgEstudio @relation(fields: [idpe], references: [idpe])
  actividades AlumnoActividad[]
  receptor    Receptor[]
}

enum EstadoAlumnoActividad {
  INSCRITO
  COMPLETADO
  ABANDONADO
}

model AlumnoActividad {
  id          Int            @id @default(autoincrement())
  alumnoId    Int
  actividadId Int
  estado      EstadoAlumnoActividad         // Ej: Inscrito, Completado, Abandonado
  asistio     Boolean        @default(false)
  fechaInscripcion  DateTime  @default(now())
  fechaConluida     DateTime? // Opcional: Fecha de completado de la actividad
  alumno      Estudiante         @relation(fields: [alumnoId], references: [idest]) // Relación con Alumno
  actividad   Actividad      @relation(fields: [actividadId], references: [idActivi]) // Relación con Actividad
  notaFinal   Float?         // Opcional: Nota de evaluación en la actividad

}

model Plantilla {
  idplantilla  Int @id @default(autoincrement())
  nombre       String
  idsubunidad  Int
  urlimg       String
  tipo         TipoReceptor
  titulo       String?
  cuerpo       String?
  pie          String?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
  
  subunidad    Sub_unidad @relation(fields: [idsubunidad], references: [id_subuni])
  certificados Certificado[]
}

enum TipoReceptor {
  PARTICIPANTE
  ORGANIZADOR
  COLABORADOR
  EXTERNO
}

model Certificado {
  idcertificado   Int        @id @default(autoincrement())
  idreceptor      Int
  codigo          String     @unique
  nombre          String
  createdAt       DateTime   @default(now())
  tipo            TipoReceptor     // 'Participante', 'Organizador', etc.
  idplantilla     Int     // URL de la plantilla del certificado
  actividad_ids   Int[]       // IDs de las actividades asociadas [1,2,3]
  urlpdf          String?     // Opcional: URL del PDF generado   
  QR              String?     // Opcional: URL del QR del certificado
  plantilla       Plantilla  @relation(fields: [idplantilla], references: [idplantilla])
  receptor        Receptor   @relation(fields: [idreceptor], references: [id_receptor])
}

enum Tipo {
  ESTUDIANTE
  EXTERNO
}

model Receptor {
  id_receptor   Int @id @default(autoincrement())
  tipo          Tipo // 'Estudiante', 'Externo', etc.
  id_estudiante Int? // FK hacia Estudiante
  id_externo    Int? // FK hacia Externo
  
  estudiante    Estudiante? @relation(fields: [id_estudiante], references: [idest])
  externo       Externo?    @relation(fields: [id_externo], references: [id_ext])
  certificados  Certificado[] // Relación con certificados emitidos a este receptor
}

model Externo {
  id_ext     Int      @id @default(autoincrement())
  nombre     String
  apellido   String
  email      String?  // Opcional, si deseas permitir certificados sin correo electrónico
  dni        String  @unique// Opcional, si necesitas identificar externamente con un documento
  telefono   String?  // Información de contacto adicional
  receptor   Receptor[] // Relación con los receptores externos
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt
}

model Carrusel {
  idcarrusel    Int @id @default(autoincrement())
  img           String
  titulo        String
  subtitulo     String
}

model Anuncio {
  idanuncio     Int @id @default(autoincrement())
  titulo        String
  descripcion   String
  fInicio       DateTime
  fFin          DateTime
}

enum Estado {
  COMPLETADO
  ENPROCESO
  PENDIENTE
  ARCHIVADO
}

model task {
  idtask        Int @id @default(autoincrement())
  title         String
  description   String?
  estado   Estado @default(PENDIENTE)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
}