generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("POSTGRESDB_URL")
}

// ==========================================
// 1. TABLA PRINCIPAL DE USUARIOS (Fusión de User y DatosUsuario)
// ==========================================
model User {
  idUser            Int       @id @default(autoincrement())
  
  // Datos de autenticación
  cOpenId           String?   @unique // Opcional, para login con Google/Microsoft
  cEmail            String    @unique
  cPassword         String?   // Contraseña (si se loguea manual)
  cLoginMethod      String?   // Ej: 'LOCAL', 'GOOGLE'

  // Datos personales
  cDni              String?   @db.Char(8) @unique
  cNombre           String?
  cAPaterno         String?
  cAMaterno         String?
  
  // Control de seguridad y auditoría
  dLastFailedAttempt DateTime?
  nFailedAttempts    Int      @default(0)
  dDeletedAt         DateTime? // Soft delete
  
  dCreatedAt        DateTime  @default(now())
  dUpdatedAt        DateTime  @updatedAt
  dLastSignedIn     DateTime  @default(now())

  // Llaves foráneas

  // Relación con sus roles y oficinas (La tabla intermedia)
  perfiles          UsuarioUniversidad[] 

  @@map("user")
}

// ==========================================
// 2. TABLA DE ROLES (Reemplaza a "Profile")
// ==========================================
model Rol {
  idRol          Int      @id @default(autoincrement())
  cNombreRol           String   @unique
  cAbrevRol           String

  dCreatedAt       DateTime @default(now())
  dUpdatedAt       DateTime @updatedAt
  
  detallePermisos DetallePermiso[]
  
  // Relaciones inversas
  asignaciones    UsuarioUniversidad[] 
  invitaciones    Invitation[] // Invitaciones que otorgan este rol

  @@map("rol")
}

// ==========================================
// 3. TABLA INTERMEDIA (Une User, Rol y Oficina)
// ==========================================
model UsuarioUniversidad {
  idUsuarioUni         Int      @id @default(autoincrement())
  lVigente         Boolean  @default(true)

  // Llaves foráneas
  idUser         Int      
  idRol         Int      
  idOficina      Int
  
  // AQUÍ ESTÁ LA MAGIA MANTIS BT: Rol temporal
  dExpiresAt     DateTime? 

  dCreatedAt      DateTime @default(now())
  dUpdatedAt      DateTime @updatedAt
  
  // Relaciones
  user           User         @relation(fields: [idUser], references: [idUser], onDelete: Cascade)
  rol            Rol          @relation(fields: [idRol], references: [idRol], onDelete: Cascade)
  oficina      Oficina   @relation(fields: [idOficina], references: [idOficina], onDelete: Cascade)
  
  // project        Project[]

  // Evita que un mismo usuario tenga el mismo rol dos veces en la misma oficina
  @@unique([idUser, idRol, idOficina])
  @@map("user_rol_oficina_universidad")
}

// ==========================================
// 5. PERMISOS Y OFICINAS (Quedan igual, están perfectas)
// ==========================================
model Permiso {
  idPermiso          Int      @id @default(autoincrement())
  cNombrePermiso           String   @unique
  cAbrevPermiso     String?

  dCreatedAt       DateTime @default(now())
  dUpdatedAt       DateTime @updatedAt

  detallePermisos DetallePermiso[]
  
  @@map("Permiso")
}

model DetallePermiso {
  idDetallePermiso    Int     @id @default(autoincrement())
  idRol     Int 
  idPermiso     Int
  lVigente     Boolean @default(false)
  
  permiso    Permiso @relation(fields: [idPermiso], references: [idPermiso])
  rol        Rol     @relation(fields: [idRol], references: [idRol])
  
  @@map("DetallePermiso")
}

model Oficina {
  idOficina     Int      @id @default(autoincrement())
  cNombreOficina      String   @unique
  cAbrevOficina   String

  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  asignaciones  UsuarioUniversidad[]
  // form          Form[]
  // plantillas    Plantilla[]
  // plantillasDoc PlantillaDocumento[]
  invitaciones      Invitation[]
  
  @@map("oficina")
}

// ==========================================
// 4. INVITACIONES (Para registrar oficinistas/admins)
// ==========================================
model Invitation {
  idInvitation Int      @id @default(autoincrement())
  cEmail       String   @unique
  cToken       String   @unique 
  
  // A qué rol apunta la invitación
  idRol       Int   
  idOficina    Int   
  rol          Rol      @relation(fields: [idRol], references: [idRol])
  oficina      Oficina  @relation(fields: [idOficina], references: [idOficina])

  dExpiresAt   DateTime 
  lIsUsed      Boolean  @default(false) 
  dCreatedAt   DateTime @default(now())

  @@map("invitacion")
}


